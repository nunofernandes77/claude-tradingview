//@version=5
// Turtle Trading — regras originais de Richard Dennis e William Eckhardt,
// publicadas por Curtis Faith em "The Original Turtle Trading Rules" / "Way of the Turtle".
//
// Resumo das regras:
//   N (volatilidade)  = média de Wilder do True Range de 20 barras (igual a ta.atr(20))
//   Unidade           = (Risco% x Capital) / (N x valor do ponto)  -> 1N de movimento = 1% do capital
//   Sistema 1 (S1)    = entrada no rompimento de 20 barras, saída no rompimento contrário de 10 barras
//                       filtro: ignora o sinal se o último trade S1 foi vencedor
//                       (exceto se for também um rompimento de 55 barras — "failsafe")
//   Sistema 2 (S2)    = entrada no rompimento de 55 barras, saída no rompimento contrário de 20 barras
//   Stop inicial      = 2N a partir da última entrada
//   Pirâmide          = acrescenta 1 unidade a cada 1/2 N a favor, até 4 unidades;
//                       o stop de todas as unidades sobe para 2N abaixo da última entrada
strategy("Turtle Trading (Richard Dennis)", shorttitle="Turtle", overlay=true,
     pyramiding=4, initial_capital=10000, default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=2)

// ───── Inputs ─────
grpSys   = "Sistema"
system   = input.string("Sistema 1 (20/10)", "Sistema", options=["Sistema 1 (20/10)", "Sistema 2 (55/20)"], group=grpSys)
useFilt  = input.bool(true, "S1: ignorar sinal após trade vencedor", group=grpSys)
allowLng = input.bool(true, "Permitir compras (long)", group=grpSys)
allowSht = input.bool(true, "Permitir vendas (short)", group=grpSys)

grpRisk  = "Risco e pirâmide"
nLen     = input.int(20, "Período do N (ATR)", minval=1, group=grpRisk)
riskPct  = input.float(1.0, "Risco por unidade (% do capital por 1N)", minval=0.1, step=0.1, group=grpRisk)
stopMult = input.float(2.0, "Stop (múltiplos de N)", minval=0.5, step=0.5, group=grpRisk)
addStep  = input.float(0.5, "Adicionar unidade a cada (múltiplos de N)", minval=0.1, step=0.1, group=grpRisk)
maxUnits = input.int(4, "Máximo de unidades", minval=1, maxval=4, group=grpRisk)
intQty   = input.bool(false, "Arredondar quantidade a inteiros (ações/futuros)", group=grpRisk)

grpVis   = "Visual"
showTbl  = input.bool(true, "Mostrar painel", group=grpVis)

// ───── Canais e volatilidade ─────
isS1     = system == "Sistema 1 (20/10)"
entryLen = isS1 ? 20 : 55
exitLen  = isS1 ? 10 : 20

n        = ta.atr(nLen)
entryHi  = ta.highest(high, entryLen)
entryLo  = ta.lowest(low, entryLen)
failHi   = ta.highest(high, 55)
failLo   = ta.lowest(low, 55)
exitHi   = ta.highest(high, exitLen)
exitLo   = ta.lowest(low, exitLen)

// ───── Tamanho da unidade ─────
unitQty(float nVal) =>
    q = (strategy.equity * riskPct / 100) / (nVal * syminfo.pointvalue)
    intQty ? math.floor(q) : math.round(q, 6)

// ───── Estado da posição ─────
var float nEntry     = na    // N no momento da última entrada
var float lastEntry  = na    // preço da última unidade
var float npAtOpen   = 0.0   // lucro líquido quando a posição abriu
var bool  lastWinner = false // o último trade foi vencedor? (filtro S1)

units = strategy.opentrades
pos   = strategy.position_size

if units > nz(units[1]) and units > 0
    lastEntry := strategy.opentrades.entry_price(units - 1)
    nEntry    := n[1]
if nz(pos[1]) == 0 and pos != 0
    npAtOpen := strategy.netprofit
if nz(pos[1]) != 0 and (pos == 0 or math.sign(pos) != math.sign(pos[1]))
    lastWinner := strategy.netprofit > npAtOpen
    if pos != 0
        npAtOpen := strategy.netprofit
if pos == 0
    lastEntry := na
    nEntry    := na

// Com o filtro ativo e o último trade vencedor, só entra no rompimento de 55 (failsafe)
skip   = isS1 and useFilt and lastWinner
longLv = skip ? failHi : entryHi
shrtLv = skip ? failLo : entryLo

// ───── Stops (2N da última entrada ou canal de saída, o que estiver mais próximo) ─────
longStop  = pos > 0 ? math.max(lastEntry - stopMult * nEntry, exitLo) : na
shortStop = pos < 0 ? math.min(lastEntry + stopMult * nEntry, exitHi) : na

// ───── Ordens ─────
qty = unitQty(n)

if pos == 0
    for i = 2 to 4
        strategy.cancel("Compra " + str.tostring(i))
        strategy.cancel("Venda " + str.tostring(i))
    if allowLng and qty > 0
        strategy.entry("Compra 1", strategy.long, qty=qty, stop=longLv)
    else
        strategy.cancel("Compra 1")
    if allowSht and qty > 0
        strategy.entry("Venda 1", strategy.short, qty=qty, stop=shrtLv)
    else
        strategy.cancel("Venda 1")

if pos > 0
    strategy.cancel("Venda 1")
    if units < maxUnits and qty > 0
        strategy.entry("Compra " + str.tostring(units + 1), strategy.long, qty=qty, stop=lastEntry + addStep * nEntry)
    for i = 1 to 4
        strategy.exit("Sair Compra " + str.tostring(i), "Compra " + str.tostring(i), stop=longStop)

if pos < 0
    strategy.cancel("Compra 1")
    if units < maxUnits and qty > 0
        strategy.entry("Venda " + str.tostring(units + 1), strategy.short, qty=qty, stop=lastEntry - addStep * nEntry)
    for i = 1 to 4
        strategy.exit("Sair Venda " + str.tostring(i), "Venda " + str.tostring(i), stop=shortStop)

// ───── Gráfico ─────
plot(entryHi, "Canal de entrada (topo)", color=color.new(color.green, 0), linewidth=1)
plot(entryLo, "Canal de entrada (fundo)", color=color.new(color.red, 0), linewidth=1)
plot(exitHi, "Canal de saída (topo)", color=color.new(color.orange, 40), style=plot.style_stepline)
plot(exitLo, "Canal de saída (fundo)", color=color.new(color.orange, 40), style=plot.style_stepline)
plot(longStop, "Stop compra", color=color.new(color.fuchsia, 0), style=plot.style_linebr, linewidth=2)
plot(shortStop, "Stop venda", color=color.new(color.fuchsia, 0), style=plot.style_linebr, linewidth=2)
bgcolor(pos > 0 ? color.new(color.green, 92) : pos < 0 ? color.new(color.red, 92) : na)

var table tbl = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1)
if showTbl and barstate.islast
    dir = pos > 0 ? "COMPRADO" : pos < 0 ? "VENDIDO" : "FORA"
    table.cell(tbl, 0, 0, "Turtle", text_color=color.white)
    table.cell(tbl, 1, 0, system, text_color=color.white)
    table.cell(tbl, 0, 1, "Posição", text_color=color.white)
    table.cell(tbl, 1, 1, dir, text_color=pos > 0 ? color.lime : pos < 0 ? color.red : color.gray)
    table.cell(tbl, 0, 2, "Unidades", text_color=color.white)
    table.cell(tbl, 1, 2, str.tostring(units) + "/" + str.tostring(maxUnits), text_color=color.white)
    table.cell(tbl, 0, 3, "N (ATR)", text_color=color.white)
    table.cell(tbl, 1, 3, str.tostring(n, format.mintick), text_color=color.white)
    table.cell(tbl, 0, 4, "Stop", text_color=color.white)
    table.cell(tbl, 1, 4, pos != 0 ? str.tostring(pos > 0 ? longStop : shortStop, format.mintick) : "-", text_color=color.white)
    table.cell(tbl, 0, 5, "Filtro S1", text_color=color.white)
    table.cell(tbl, 1, 5, skip ? "Só failsafe 55" : "Normal", text_color=color.white)
